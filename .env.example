# LLM — Groq (recommended for local MVP testing; get key at https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=gsk_your_groq_api_key_here

# LLM — Ollama desktop (recommended split: Ollama for LLM, Groq for voice STT)
# 1) Install Ollama desktop from https://ollama.com/download
# 2) Pull model: ollama pull qwen2.5:7b  (or use Ollama app → Models)
# 3) Keep Ollama app running in background
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=not-needed

# Voice — fast LLM for live browser demo (Groq strongly recommended)
VOICE_LLM_BASE_URL=https://api.groq.com/openai/v1
VOICE_LLM_MODEL=llama-3.1-8b-instant
VOICE_LLM_API_KEY=gsk_your_groq_api_key_here

# STT — Groq Whisper (voice only; required even when LLM is Ollama)
STT_API_KEY=gsk_your_groq_api_key_here
STT_MODEL=whisper-large-v3

# Alternatives:
# Ollama only (no Groq): voice tests use text passthrough — no mic STT
# vLLM (RunPod):   LLM_BASE_URL=http://127.0.0.1:8001/v1   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Order API (dialogue agent calls this — must match run_api.py port)
ORDER_API_BASE_URL=http://127.0.0.1:8080

# Voice — Sprint 4 (TTS via Edge)
TTS_VOICE=en-US-JennyNeural
TTS_ENABLED=true
VOICE_PORT=8090

# Hugging Face — model downloads (Sprint 3+)
HF_TOKEN=hf_your_read_token_here

# PostgreSQL — local Docker default
DATABASE_URL=postgresql+asyncpg://voice_agent:voice_agent_dev@127.0.0.1:5432/voice_agent

# Redis (optional — local Docker default)
REDIS_URL=redis://127.0.0.1:6379/0

# Store hours — set false in dev/tests to order outside business hours
ENFORCE_STORE_HOURS=false

# Payment + SMS (Sprint 6 mock services — empty = in-process fallback)
PAYMENT_SERVICE_URL=
SMS_GATEWAY_URL=
