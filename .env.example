# LLM — Groq (recommended for local MVP testing; get key at https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=gsk_your_groq_api_key_here

# Alternatives:
# Ollama (local):  LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=qwen2.5:3b  LLM_API_KEY=not-needed
# vLLM (RunPod):   LLM_BASE_URL=http://127.0.0.1:8001/v1   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Order API (dialogue agent calls this)
ORDER_API_BASE_URL=http://127.0.0.1:8080

# Hugging Face — model downloads (Sprint 3+)
HF_TOKEN=hf_your_read_token_here

# PostgreSQL (Aiven) — never commit real credentials
DATABASE_URL=postgresql+asyncpg://user:password@host:port/defaultdb?ssl=require

# Redis (optional — local Docker default)
REDIS_URL=redis://127.0.0.1:6379/0
